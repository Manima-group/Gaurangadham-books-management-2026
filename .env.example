# PostgreSQL connection (on Neon: the pooled "-pooler" string; `neon env pull` writes it)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gaurangadham
# Optional, Neon only: direct (non-pooled) string, used for db:push, seed, backup/restore
# DATABASE_URL_UNPOOLED=
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
